{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand",
          "thirdperson_righthand",
          "thirdperson_lefthand"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:charge_type",
          "cases": [
            {
              "when": "arrow",
              "model": {
                "type": "minecraft:model",
                "model": "icesmp:item/states/pyralingradi_ostrom_szamszerij_charged"
              }
            },
            {
              "when": "rocket",
              "model": {
                "type": "minecraft:model",
                "model": "icesmp:item/states/pyralingradi_ostrom_szamszerij_charged_rocket"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_false": {
              "type": "minecraft:model",
              "model": "icesmp:item/pyralingradi_ostrom_szamszerij"
            },
            "on_true": {
              "type": "minecraft:range_dispatch",
              "property": "minecraft:crossbow/pull",
              "fallback": {
                "type": "minecraft:model",
                "model": "icesmp:item/states/pyralingradi_ostrom_szamszerij_pull_0"
              },
              "entries": [
                {
                  "threshold": 0.58,
                  "model": {
                    "type": "minecraft:model",
                    "model": "icesmp:item/states/pyralingradi_ostrom_szamszerij_pull_1"
                  }
                },
                {
                  "threshold": 1.0,
                  "model": {
                    "type": "minecraft:model",
                    "model": "icesmp:item/states/pyralingradi_ostrom_szamszerij_pull_2"
                  }
                }
              ]
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "icesmp:item/pyralingradi_ostrom_szamszerij"
    }
  },
  "hand_animation_on_swap": false,
  "oversized_in_gui": false,
  "swap_animation_scale": 1.0
}

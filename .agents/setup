#!/usr/bin/env bash
set -euo pipefail

if command -v java >/dev/null 2>&1 && command -v javac >/dev/null 2>&1 \
  && java -version 2>&1 | grep -q 'version "21\|openjdk version "21'; then
  exit 0
fi

JDK_DIR="/opt/icesmp-jdk-21"
if [[ ! -x "${JDK_DIR}/bin/java" ]]; then
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' EXIT

  sudo apt-get update
  sudo apt-get install -y ca-certificates curl tar

  curl -LfsS \
    "https://api.adoptium.net/v3/binary/latest/21/ga/linux/x64/jdk/hotspot/normal/eclipse?project=jdk" \
    -o "${tmp_dir}/jdk21.tar.gz"

  sudo rm -rf "${JDK_DIR}"
  sudo mkdir -p "${JDK_DIR}"
  sudo tar -xzf "${tmp_dir}/jdk21.tar.gz" -C "${JDK_DIR}" --strip-components=1
fi

sudo ln -sf "${JDK_DIR}/bin/java" /usr/local/bin/java
sudo ln -sf "${JDK_DIR}/bin/javac" /usr/local/bin/javac
sudo ln -sf "${JDK_DIR}/bin/jar" /usr/local/bin/jar

java -version
